# Base de datos (Postgres — Neon o Supabase)
DATABASE_URL="postgresql://user:password@host:5432/meridian"

# Auth.js
AUTH_SECRET="genera-uno-con: npx auth secret"
# Necesario al correr `next start` fuera de Vercel (en Vercel se define solo)
# AUTH_TRUST_HOST="true"

# URL pública del sitio (para SEO, webhooks, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Usuario admin creado por `npm run db:seed` (opcionales)
# ADMIN_EMAIL="admin@meridian.local"
# ADMIN_PASSWORD="admin1234"
# ADMIN_NAME="Admin"

# Moneda y locale para formatear precios (opcionales; por defecto COP / es-CO)
# NEXT_PUBLIC_CURRENCY="COP"
# NEXT_PUBLIC_LOCALE="es-CO"

# Pasarela de pago (Etapa 6)
# "wompi" (por defecto si hay llaves) o "mock" (solo desarrollo/pruebas)
# PAYMENT_PROVIDER="wompi"
# Llaves de Wompi (usa las pub_test_/prv_test_ del sandbox para probar)
# WOMPI_PUBLIC_KEY="pub_test_xxx"
# WOMPI_INTEGRITY_SECRET="test_integrity_xxx"
# WOMPI_EVENTS_SECRET="test_events_xxx"
# Secreto del webhook del proveedor mock (solo desarrollo)
# MOCK_WEBHOOK_SECRET="mock-secret"

# Vercel Blob (solo producción; Vercel lo inyecta al conectar el store)
# Sin este token, las imágenes se guardan en public/uploads/ (dev)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
